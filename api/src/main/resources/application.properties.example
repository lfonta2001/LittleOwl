spring.application.name=api

oauth.discord.client.id=<YOUR DISCORD CLIENT ID>
oauth.discord.client.secret=<YOUR DISCORD CLIENT SECRET>
oauth.discord.redirect=<THE SAME URL SET IN DISCORD OAUTH CODE PETITION>
oauth.google.client.id=<YOUR GOOGLE CLIENT ID>
oauth.google.client.secret=<YOUR GOOGLE CLIENT SECRET>
oauth.google.redirect=<THE SAME URL SET IN GOOGLE OAUTH CODE PETITION>
oauth.github.client.id=<YOUR GITHUB CLIENT ID>
oauth.github.client.secret=<YOUR GITHUB CLIENT SECRET>
oauth.github.redirect=<THE SAME URL SET IN GITHUB OAUTH CODE PETITION>

security.jwt.secret=<YOUR TOKEN FOR JWT CREATION>
security.jwt.tol=<THE TIME YOU WANT YOUR ACCESS TOKEN TO LAST IN MILLISECONDS>
security.jwt.refresh.tol=<THE TIME YOU WANT YOUR REFRESH TOKEN TO LAST IN MILLISECONDS>
